  </defs>
  <rect width="800" height="1000" fill="url(#bg2)" />
  <rect x="30" y="30" width="740" height="940" rx="20" fill="none" stroke="rgba(251, 191, 36, 0.25)" stroke-width="2" stroke-dasharray="10 10" />
  
  <g transform="translate(400, 420)" text-anchor="middle">
    <circle cx="0" cy="-60" r="80" fill="none" stroke="url(#gold)" stroke-width="4" opacity="0.8" />
