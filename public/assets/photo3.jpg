<svg xmlns="http://www.w3.org/2000/svg" width="800" height="1000" viewBox="0 0 800 1000">
  <defs>
    <radialGradient id="bg3" cx="50%" cy="40%" r="70%">
      <stop offset="0%" stop-color="#341c22" />
      <stop offset="60%" stop-color="#190e13" />
      <stop offset="100%" stop-color="#0a0507" />
    </radialGradient>
    <linearGradient id="roseAura" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f43f5e" />
      <stop offset="50%" stop-color="#fb7185" />
      <stop offset="100%" stop-color="#fef08a" />
    </linearGradient>
  </defs>
  <rect width="800" height="1000" fill="url(#bg3)" />
  <rect x="30" y="30" width="740" height="940" rx="20" fill="none" stroke="rgba(244, 63, 94, 0.25)" stroke-width="2" stroke-dasharray="10 10" />
  
  <g transform="translate(400, 420)" text-anchor="middle">
    <circle cx="0" cy="-60" r="80" fill="none" stroke="url(#roseAura)" stroke-width="4" opacity="0.8" />
    <path d="M-90,110 C-80,0 80,0 90,110" fill="none" stroke="url(#roseAura)" stroke-width="4" opacity="0.8" />
    <circle cx="0" cy="-60" r="56" fill="rgba(244, 63, 94, 0.15)" />
    <text y="-50" font-family="system-ui, sans-serif" font-size="38" font-weight="bold" fill="#ffffff">#3</text>
  </g>
  
  <text x="400" y="630" font-family="system-ui, sans-serif" font-size="28" font-weight="600" fill="#fecdd3" text-anchor="middle" letter-spacing="2">
    SWASTIKA'S PHOTO 3
  </text>
