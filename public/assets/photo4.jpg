  </defs>
  <rect width="800" height="1000" fill="url(#bg4)" />
  <rect x="30" y="30" width="740" height="940" rx="20" fill="none" stroke="rgba(232, 121, 249, 0.25)" stroke-width="2" stroke-dasharray="10 10" />
  
