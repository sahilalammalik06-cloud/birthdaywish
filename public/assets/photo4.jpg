    <linearGradient id="roseGold4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f472b6" />
      <stop offset="50%" stop-color="#e879f9" />
      <stop offset="100%" stop-color="#fbcfe8" />
